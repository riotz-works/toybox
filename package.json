{
  "name": "toybox",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "clean": "rimraf node_modules/.cache && pnpm -r --if-present --parallel run clean",
    "build": "tsc && pnpm run -r --parallel --if-present build",
    "lint": "npm-run-all -p lint:*",
    "lint:eslint": "eslint . --concurrency=auto --cache --cache-location=node_modules/.cache/eslint/",
    "lint:knip": "knip --tags=-knipignore --cache",
    "package": "pnpm run -r --parallel --if-present package",
    "deploy": "pnpm run -r --parallel --if-present deploy",
    "infra": "pnpm -F infra"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/compat": "2.0.5",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.0.0",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "eslint": "10.2.0",
    "eslint-formatter-table": "7.32.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "fixme": "0.7.0",
    "globals": "17.5.0",
    "knip": "6.4.1",
    "npm-run-all2": "8.0.4",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2"
  },
  "trustPolicy": "strict",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "changelog": {
    "labels": {
      "Type: Breaking": "💥 Breaking Change",
      "Type: Feature": "🎉 New Feature",
      "Type: Enhancement": "🚀 Enhancement",
      "Type: Security": "🛡️ Security",
      "Type: BugFix": "💉 Bug Fix",
      "Type: Deprecated": "⚠️ Deprecated",
      "Type: Docs": "📝 Documentation",
      "Type: Refactoring": "✨ Refactoring",
      "Type: Testing": "✅ Testing",
      "Type: Build": "🛠️ Build",
      "Type: Dependency": "📦 Dependency",
      "Type: Misc": "🧩 misc"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/riotz-works/toybox",
    "productOwners": [
      "riotz-po"
    ]
  },
  "author": "Riotz.works (https://riotz.works)",
  "license": "UNLICENSED"
}
